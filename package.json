{
  "name": "notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-info.mjs && vite --host 127.0.0.1",
    "dev:api": "node scripts/build-info.mjs && wrangler dev",
    "build": "node scripts/build-info.mjs && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "node scripts/build-info.mjs && tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build && wrangler deploy",
    "e2e": "node e2e/run.mjs",
    "e2e:prod": "E2E_BASE_URL=https://notes.huyab.click node e2e/readonly-smoke.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@huyab/sso": "github:nguyenhuy158/kit#v0.1.0&path:packages/sso",
    "@tailwindcss/vite": "^4.0.0",
    "date-fns": "^4.4.0",
    "hono": "^4.12.27",
    "lucide-react": "^1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "^5.20260703.1",
    "@huyab/config": "github:nguyenhuy158/kit#v0.1.0&path:packages/config",
    "@huyab/e2e": "github:nguyenhuy158/kit#v0.1.0&path:packages/e2e",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.106.0"
  }
}
